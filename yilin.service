[Unit]
Description=Yilin Translator (Next.js dev server)
After=network.target

[Service]
Type=simple
User=severs
Environment=NODE_ENV=
WorkingDirectory=/home/severs/yilin-translator
ExecStart=/home/severs/yilin-translator/node_modules/.bin/next dev -p 8666 --hostname 0.0.0.0
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
